{
  "rewrites": [
    {
      "source": "/slownik-wskaznikow",
      "destination": "/index.html"
    },
    {
      "source": "/telegram",
      "destination": "/index.html"
    },
    {
      "source": "/zastrzezenia",
      "destination": "/index.html"
    },
    {
      "source": "/prywatnosc",
      "destination": "/index.html"
    },
    {
      "source": "/regulamin",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
