{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Hanken Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Hanken Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:live|stale|missing|ice|gold|neutral)$/]",
        "message": "<Badge> tone must be one of 'live' | 'stale' | 'missing' | 'ice' | 'gold' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|layout|tagline|taglineColor|href|glow|style|key|ref|className|style|children)$/]",
        "message": "<BrandLockup> doesn't accept that prop. Declared props: size, layout, tagline, taglineColor, href, glow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLockup'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<BrandLockup> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLockup'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stack|inline|mark)$/]",
        "message": "<BrandLockup> layout must be one of 'stack' | 'inline' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|fullWidth|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, fullWidth, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|gold|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'gold' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|eyebrow|title|accent|interactive|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, eyebrow, title, accent, interactive, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:ice|gold)$/]",
        "message": "<Card> accent must be one of 'ice' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|prefix|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, color, prefix, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GaugeSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:to|color|key|ref|className|style|children)$/]",
        "message": "<GaugeSegment> doesn't accept that prop. Declared props: to, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|placeholder|iconLeft|value|defaultValue|onChange|hint|id|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, type, placeholder, iconLeft, value, defaultValue, onChange, hint, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|sub|accent|align|style|key|ref|className|style|children)$/]",
        "message": "<KpiStat> doesn't accept that prop. Declared props: label, value, unit, sub, accent, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiStat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<KpiStat> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LockOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|note|cta|onUpgrade|blur|minHeight|compact|style|key|ref|className|style|children)$/]",
        "message": "<LockOverlay> doesn't accept that prop. Declared props: children, title, note, cta, onUpgrade, blur, minHeight, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|eyebrow|children|footer|width|side|closeOnBackdrop|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, title, eyebrow, children, footer, width, side, closeOnBackdrop, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:right)$/]",
        "message": "<Modal> side must be one of 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|max|size|stroke|label|verdict|caption|style|key|ref|className|style|children)$/]",
        "message": "<ScoreRing> doesn't accept that prop. Declared props: score, max, size, stroke, label, verdict, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreRing'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:too_early|observe|accumulate|aggressive)$/]",
        "message": "<ScoreRing> verdict must be one of 'too_early' | 'observe' | 'accumulate' | 'aggressive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|color|width|height|strokeWidth|area|glow|markers|style|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: data, color, width, height, strokeWidth, area, glow, markers, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ice|emerald|amber|red|slate|gold)$/]",
        "message": "<StatusChip> tone must be one of 'ice' | 'emerald' | 'amber' | 'red' | 'slate' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<StatusChip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|content|side|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: children, content, side, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:top|bottom|left|right)$/]",
        "message": "<Tooltip> side must be one of 'top' | 'bottom' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictScale'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|showLabels|style|key|ref|className|style|children)$/]",
        "message": "<VerdictScale> doesn't accept that prop. Declared props: score, showLabels, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
